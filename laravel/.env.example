# =============================================================================
# Frontend Laravel RootWarden v2.0 — modele d'environnement
# =============================================================================
#
# Copier en `.env` (ignore par git). L'entrypoint du conteneur genere APP_KEY
# au premier demarrage si elle est vide.
#
# Les identifiants de base NE SONT PAS repris ici : le conteneur recoit
# `srv-docker.env` via `env_file`, et `config/database.php` lit MYSQL_DATABASE /
# MYSQL_USER / MYSQL_PASSWORD en repli. Dupliquer un mot de passe dans deux
# fichiers, c'est garantir qu'un jour les deux divergeront.
# =============================================================================

APP_NAME=RootWarden
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8444

# Le portail est bilingue et la parite FR/EN est une regle du projet.
# Le francais est la langue de reference, l'anglais le repli.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de donnees ──────────────────────────────────────────────────────────
# Schema PARTAGE avec le backend Python. AUCUNE migration Laravel, jamais :
# voir database/migrations/README.md.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
# DB_DATABASE / DB_USERNAME / DB_PASSWORD sont repris de MYSQL_* (srv-docker.env)
# par config/database.php. Les renseigner ici seulement pour surcharger.

# ── Pilotes : FICHIER, jamais BASE ───────────────────────────────────────────
# Laravel 13 propose `database` par defaut pour la session, la file et le
# cache. Ces trois pilotes exigent les tables `sessions`, `jobs` et `cache`,
# c'est-a-dire exactement les migrations que ce projet a supprimees parce que
# le schema ne lui appartient pas. Les laisser sur `database` casserait
# l'application a la premiere requete, avec une erreur SQL et non un message
# clair.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=sync
CACHE_STORE=file

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
