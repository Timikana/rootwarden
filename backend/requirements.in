# requirements.in - source pour pip-compile (Patch A06-NEW-01 OWASP A06).
#
# Generer requirements.txt verrouille avec hashes :
#   docker run --rm -v $(pwd)/backend:/io -w /io python:3.13-slim sh -c \
#     'pip install pip-tools && pip-compile --generate-hashes --output-file=requirements.txt requirements.in'
#
# Puis dans backend/Dockerfile :
#   RUN pip install --require-hashes -r requirements.txt
#
# Sans --require-hashes, un attaquant compromettant PyPI peut publier une
# version pinned modifiee et l'installation tirera silencieusement la
# nouvelle. Avec hashes, la pip refuse tout artefact dont le hash ne
# matche pas celui ecrit dans requirements.txt.

