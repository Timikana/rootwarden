# ================================================================
# RootWarden - Fichier de configuration
# ================================================================
# Copiez ce fichier : cp srv-docker.env.example srv-docker.env
# Puis remplissez chaque valeur avant de lancer docker-compose.
#
# Générer des clés aléatoires sécurisées :
#   openssl rand -hex 32   → pour SECRET_KEY, ENCRYPTION_KEY, API_KEY
#   openssl rand -hex 16   → pour une clé 128 bits
#
# ⚠️  SECURITE - A lire avant le deploiement en production :
#
#   1. Changez TOUTES les valeurs par defaut (SECRET_KEY, API_KEY, DB_PASSWORD, etc.)
#   2. Protegez ce fichier : chmod 600 srv-docker.env
#   3. Ne commitez JAMAIS ce fichier avec des secrets reels (il est dans .gitignore)
#   4. Apres le premier demarrage, supprimez INIT_SUPERADMIN_PASSWORD de ce fichier
#   5. Le mot de passe superadmin est auto-genere si INIT_SUPERADMIN_PASSWORD est vide
#   6. Le changement de mot de passe est force a la premiere connexion
# ================================================================


# ----------------------------------------------------------------
# Chiffrement des mots de passe en base (AES-256)
# OBLIGATOIRE - ne jamais laisser vide
# ----------------------------------------------------------------
SECRET_KEY=CHANGEZ_MOI_openssl_rand_hex_32

# Ancienne clé (uniquement si vous migrez depuis une version précédente)
# Laissez vide si vous installez pour la première fois
OLD_SECRET_KEY=

# Clé de protection supplémentaire (optionnel - non utilisée par le backend Python actuellement)
# ENCRYPTION_KEY=CHANGEZ_MOI_openssl_rand_hex_32


# ----------------------------------------------------------------
# Clé d'API - authentifie les requêtes du frontend vers le backend
# OBLIGATOIRE - ne jamais laisser vide
# ----------------------------------------------------------------
API_KEY=CHANGEZ_MOI_openssl_rand_hex_32


# ----------------------------------------------------------------
# Installation - mot de passe initial du superadmin
#
# Utilise UNIQUEMENT au premier demarrage (install.sh).
# Si vide, un mot de passe aleatoire est genere et
# affiche dans les logs Docker (docker logs <conteneur_php>).
# Ignore apres le premier demarrage.
# Les autres utilisateurs sont crees depuis l'interface Admin.
# ----------------------------------------------------------------
# INIT_SUPERADMIN_PASSWORD=


# ----------------------------------------------------------------
# Branding - personnalisation de l'interface (white-label)
#
# APP_NAME    : nom affiché dans le menu, le titre des pages et la page de login
# APP_TAGLINE : sous-titre affiché sur la page de login
# APP_COMPANY : nom de votre entreprise/client (ex: Piscines MAGILINE)
#               Affiché dans le menu et sur la page de login
#               Laissez vide pour ne rien afficher
# ----------------------------------------------------------------
APP_NAME=RootWarden
APP_TAGLINE=Gestion SSH centralisée
APP_COMPANY=

# ─────────────────────────────────────────────────────────────
# Frontend Laravel v2.0 (migration en cours)
# ─────────────────────────────────────────────────────────────
# Le frontend Laravel tourne EN PARALLÈLE du legacy pendant la migration, sur
# un port distinct. Le legacy (8443) reste la référence tant que la parité
# d'un module n'est pas prouvée.
LARAVEL_PORT=8444

# Port HTTPS du portage. ⚠ AJOUTE LE 2026-09-06 : le portail servait
# l'authentification EN CLAIR (seul 8444->80 etait publie, aucun 443). Mot de
# passe et code TOTP transitaient en clair, alors que le legacy a du TLS.
#
# ⚠ VALEUR LITTERALE, PAS `${...}` : dans un fichier d'environnement une
# variable ne peut referencer que ce qui est defini PLUS HAUT, et une reference
# non resolue rend une valeur VIDE au lieu d'une erreur (`http://:`).
#
# Ce port sert DEUX fois et les deux doivent concorder : l'hote le publie
# (compose) et l'entrypoint construit la redirection HTTP -> HTTPS avec. Leurs
# defauts sont egaux (8446) : les desaccorder produirait une redirection vers un
# port sans TLS — exactement le defaut mesure sur le legacy le 2026-09-06.
LARAVEL_HTTPS_PORT=8446

# URL PUBLIQUE du frontend Laravel. Le menu du legacy y renvoie pour les pages
# deja portees, plutot que de mener a une page archivee.
#
# DEUX PIEGES, PAYES TOUS LES DEUX.
#
# 1. LE SCHEMA. Le portage ecoute EN CLAIR sur ce port : c'est Apache du
#    conteneur `laravel`, sans TLS. Poser `https://` ici faisait echouer la
#    negociation TLS, et les HUIT entrees de menu redirigees menaient a un lien
#    mort — sans qu'aucune suite ne rougisse, parce qu'elles comparaient des
#    chaines au lieu de suivre le lien. `archive.mjs` termine desormais par une
#    REQUETE.
#
# 2. `localhost` NE VAUT QUE DEPUIS LA MACHINE HOTE. Un lien servi a un
#    navigateur mene au localhost DU VISITEUR. Des que les portails sont ouverts
#    depuis un autre poste, poser ici l'adresse ou le nom que ce poste resout —
#    d'ou `${SERVER_NAME}` plutot qu'un `localhost` en dur.
LARAVEL_URL=http://${SERVER_NAME}:${LARAVEL_PORT}

# URL PUBLIQUE du legacy, dans l'autre sens : le portage y renvoie pour tout ce
# qui n'est pas encore porte (une vingtaine d'entrees de menu pour un role 3, et
# les exports du rapport de conformite). Meme regle que ci-dessus — `localhost`
# ici mene le visiteur chez lui. Lue par `laravel/config/app.php`
# (`app.url_legacy`), et par la suite `go-socle-navigation`, qui la lit dans la
# configuration plutot que de l'ecrire en dur.
LEGACY_URL=https://${SERVER_NAME}:${HTTPS_PORT}
# Fuseau des dates affichées par le frontend Laravel. Sans lui, les deux
# frontends datent la même donnée à deux heures d'écart.
APP_TIMEZONE=Europe/Paris

# URL INTERNE du backend Python, utilisee par la passerelle Laravel. Le
# navigateur ne la voit jamais : il passe par /api/gateway. Ne pas confondre
# avec API_URL, qui est l'URL publique.
BACKEND_INTERNAL_URL=https://python:5000
# Delai d'attente de la passerelle, en secondes. Certaines routes de parc
# (scan CVE, mise a jour) durent longtemps.
BACKEND_TIMEOUT=120
# Delai des routes relayees EN FLUX par la passerelle Laravel (mise a jour
# de securite, simulation) : leur reponse reste ouverte pendant la commande.
BACKEND_TIMEOUT_FLUX=900


# ----------------------------------------------------------------
# Serveur
# ----------------------------------------------------------------
# `localhost` NE CONVIENT QUE POUR UN ACCES DEPUIS LA MACHINE HOTE. Cette valeur
# alimente `LARAVEL_URL` et `LEGACY_URL`, qui sont servies A UN NAVIGATEUR : un
# lien en `localhost` mene au localhost DU VISITEUR, donc nulle part. Des que les
# portails sont ouverts depuis un autre poste, poser ici l'adresse IP ou le nom
# que ce poste resout.
SERVER_NAME=localhost
SERVER_ADMIN=admin@example.com


# ----------------------------------------------------------------
# Base de données MySQL
# ----------------------------------------------------------------
DB_HOST=db
DB_NAME=rootwarden
DB_USER=rootwarden_user
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_bdd
# DB_PORT=3306  # Port MySQL (défaut : 3306) - décommenter uniquement si non-standard

# MySQL Docker - doit correspondre aux valeurs DB_* ci-dessus
MYSQL_ROOT_PASSWORD=CHANGEZ_MOI_mot_de_passe_root_mysql
MYSQL_DATABASE=${DB_NAME}
MYSQL_USER=${DB_USER}
MYSQL_PASSWORD=${DB_PASSWORD}


# ----------------------------------------------------------------
# Ports exposés
# ----------------------------------------------------------------
HTTP_PORT=8080
HTTPS_PORT=8443
PYTHON_PORT=5000
MYSQL_PORT=3306


# ----------------------------------------------------------------
# URLs de l'application (utilisées par le frontend JS)
# ----------------------------------------------------------------
URL_HTTP=http://${SERVER_NAME}:${HTTP_PORT}
URL_HTTPS=https://${SERVER_NAME}:${HTTPS_PORT}
API_URL=https://${SERVER_NAME}:${PYTHON_PORT}

# ----------------------------------------------------------------
# URL publique (utilisée pour les emails sortants : reset password,
# notifications, etc.). À renseigner UNIQUEMENT si l'application est
# accessible via un reverse-proxy / HAProxy / load-balancer dont le
# hostname et/ou le port externe diffèrent de URL_HTTPS interne.
#
# Exemple typique :
#   URL_HTTPS=https://lagoon.dom-magiline.local:8443  (interne)
#   URL_PUBLIC_HTTPS=https://cleopatre-ssh.magiline.fr  (externe, port 443)
#
# Si non défini, les emails utilisent URL_HTTPS (comportement legacy).
# ----------------------------------------------------------------
# URL_PUBLIC_HTTPS=


# ----------------------------------------------------------------
# SSL - mode de gestion du certificat
#
#   auto     (défaut) : certificat auto-signé généré au premier démarrage.
#                        Idéal pour les tests ou les LAN internes.
#
#   custom            : vous fournissez vos propres certificats (Let's Encrypt,
#                        certificat d'entreprise…).
#                        Montez vos fichiers dans ./certs/ et renseignez les
#                        chemins ci-dessous. Le conteneur refusera de démarrer
#                        si les fichiers sont absents.
#
#   disabled          : TLS entièrement désactivé côté Apache.
#                        Utilisez ce mode si un reverse proxy (Nginx, Traefik,
#                        Caddy, HAProxy…) gère le TLS en amont.
#                        Le port 443 n'est alors plus nécessaire.
# ----------------------------------------------------------------
SSL_MODE=auto

# Chemin des certificats (utilisé seulement si SSL_MODE=custom)
SSL_CERT_PATH=/var/www/certs/custom.crt
SSL_KEY_PATH=/var/www/certs/custom.pem

# Sujet du certificat auto-signé (utilisé seulement si SSL_MODE=auto)
CERT_INFO=/C=FR/ST=IDF/L=Paris/O=MonOrganisation/OU=IT/CN=${SERVER_NAME}


# ----------------------------------------------------------------
# CORS - domaine autorisé à appeler le backend Python
# ----------------------------------------------------------------
CORS_ORIGINS=${SERVER_NAME}


# ----------------------------------------------------------------
# SSH
# ----------------------------------------------------------------
SSH_TIMEOUT=360


# ----------------------------------------------------------------
# OpenCVE - scan de vulnérabilités (CVE) sur les serveurs gérés
#
# Supporte :
#   - opencve.io (cloud)       → OPENCVE_URL=https://app.opencve.io
#                                 Utilisez OPENCVE_USERNAME + OPENCVE_PASSWORD (Basic Auth)
#   - instance on-prem v2      → OPENCVE_URL=https://opencve.mondomaine.com
#                                 Utilisez OPENCVE_TOKEN (Bearer token, prioritaire)
#
# Authentification (priorité) :
#   1. OPENCVE_TOKEN (Bearer) - recommandé pour on-prem v2
#   2. OPENCVE_USERNAME + OPENCVE_PASSWORD (Basic Auth) - cloud opencve.io
#   Laissez tout vide pour désactiver le module CVE.
# ----------------------------------------------------------------
OPENCVE_URL=https://app.opencve.io

# Bearer token pour OpenCVE v2 on-prem (prioritaire si défini)
# Généré dans : OpenCVE → Settings → API Keys
# OPENCVE_TOKEN=opc_org.xxxxx.yyyyyyyyyyyyyyyyyyy

# Basic Auth pour opencve.io cloud (fallback si pas de token)
OPENCVE_USERNAME=
OPENCVE_PASSWORD=

# Durée du cache des réponses OpenCVE (secondes). 3600 = 1 heure.
CVE_CACHE_TTL=3600

# Seuil CVSS par défaut (utilisé si l'utilisateur ne choisit pas de seuil).
# 0.0 = tout afficher | 4.0 = MEDIUM+ | 7.0 = HIGH+ | 9.0 = CRITICAL seulement
CVE_MIN_CVSS=7.0

# Pagination OpenCVE : combien de CVE par page et combien de pages max.
# Kernel/openssl/glibc ont des milliers de CVE indexees, valeurs par defaut
# adaptees pour les couvrir (jusqu'a 2000 CVE par composant).
# Forwarding GELF des logs backend vers Graylog (A09-NEW-03, optionnel).
# Si defini, le backend Python envoie ses logs en parallele a un fichier local
# et a Graylog (host:port TCP). Idee : centraliser hors container.
# Necessite : pip install graypy dans le backend.
# GRAYLOG_HOST=graylog.lan
# GRAYLOG_PORT=12201

# Audit log hash chain (A08-02) : cle HMAC dediee, distincte de SECRET_KEY.
# Doit etre un hex 64 chars (32 octets aleatoires).
# Generation : openssl rand -hex 32
# Sans cette cle, fallback sur SECRET_KEY -> separation de cle nulle, l'avantage
# du HMAC est annule. A configurer imperativement en prod.
AUDIT_HMAC_KEY=

CVE_PAGE_LIMIT=100
CVE_MAX_PAGES=20

# Enrichissement via API NVD 2.0 pour filtrer par version installee.
# OpenCVE on-prem v2 n'expose pas les configurations CPE -> sans cette option
# on recoit *toutes* les CVE d'un produit, sans filtre par version (faux+ massifs).
# Avec : on fetch chaque CVE chez NVD pour comparer la version installee aux
# ranges versionStart/End et garder uniquement les CVE applicables.
#
# Rate limit NVD : 5 req/30s sans cle, 50 req/30s avec cle (gratuite sur
# https://nvd.nist.gov/developers/request-an-api-key)
NVD_ENRICHMENT_ENABLED=true
# NVD_API_KEY=00000000-0000-0000-0000-000000000000
NVD_CACHE_TTL=604800

# ── Priorisation EPSS + CISA KEV ───────────────────────────────────────────
# Enrichit chaque CVE avec EPSS (probabilite d'exploitation 0..1, FIRST.org)
# et un flag CISA KEV (vulnerabilite activement exploitee in-the-wild). Permet
# de prioriser au-dela du seul CVSS. Gratuit, sans cle. Best-effort : si l'API
# est injoignable, le scan continue (priorisation sur le CVSS seul).
CVE_ENRICH_ENABLED=true
EPSS_API_URL=https://api.first.org/data/v1/epss
KEV_CATALOG_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CVE_ENRICH_CACHE_TTL=86400
KEV_CACHE_TTL=86400

# ── Workflow d'approbation 4-eyes ──────────────────────────────────────────
# Opt-in. Si true, les actions listees exigent l'aval d'un SECOND administrateur
# avant execution (un admin ne peut pas approuver sa propre demande).
#
# QUI PEUT APPROUVER : role 2 porteur de `can_admin_portal`, et jamais le
# demandeur lui-meme. L'approbateur n'a donc PAS besoin d'etre superadmin —
# separation des taches sans escalade.
#
# ⚠ DEUX ACTIONS NE SE CONTOURNENT PLUS PAR LE ROLE 3 (correctif E-201) :
#     regenerate_platform_key   fait tourner la paire de cles de TOUTE la flotte
#     revoke_service_account    kill-switch du compte de service
#   Pour les deux autres — delete_remote_user, reboot_server — un superadmin
#   passe encore sans approbation, comme avant.
#
#   Consequence a peser AVANT d'activer : avec un SEUL compte capable
#   d'approuver, ces deux gestes deviennent IMPOSSIBLES. Ce n'est pas un blocage
#   temporaire, c'est un verrou : il faut un second approbateur (role 2 +
#   `can_admin_portal` suffit) pour qu'ils redeviennent realisables.
#
#   Avant E-201 cette reserve ne valait que pour les administrateurs de role 2,
#   le role 3 contournant les quatre actions. Elle vaut desormais pour tout le
#   monde sur ces deux-la.
#
# ACTIF PAR DEFAUT depuis la decision du 2026-08-27. Un deploiement
# mono-administrateur n'est plus brique en SILENCE : les deux gestes
# ci-dessus refusent en NOMMANT leur cause et la marche a suivre.
APPROVAL_ENABLED=true
APPROVAL_ACTIONS=delete_remote_user,reboot_server,revoke_service_account,regenerate_platform_key
APPROVAL_TTL_HOURS=24

# ── Rotation de la cle plateforme ──────────────────────────────────────────
# `/regenerate_platform_key` ARCHIVE l'ancienne paire au lieu de la detruire :
# le volume `platform_ssh` n'est sauvegarde nulle part, et la suppression
# portait donc sur LA SEULE COPIE AU MONDE.
#
# L'archive vit dans `platform_ssh/archive/`, hors de portee du chemin
# d'authentification : une cle archivee n'est JAMAIS reutilisable pour se
# connecter. Sans quoi la rotation serait du theatre — on tourne une cle parce
# qu'on la suppose compromise.
#
# Jours avant destruction definitive. 0 desactive la purge : un secret archive
# sans date de destruction est un secret permanent qui a change de nom.
PLATFORM_KEY_ARCHIVE_DAYS=30

# ── ChatOps bidirectionnel (reception de commandes) ────────────────────────
# Les webhooks SORTANTS restent geres par WEBHOOK_* ci-dessus. Ici le sens
# ENTRANT : commandes/approbations depuis Slack ou Teams. Point d'entree public :
# /chatops/webhook.php (authentifie par signature Slack OU jeton partage, pas
# de session). Mapper les utilisateurs chat dans l'UI (page ChatOps).
CHATOPS_ENABLED=false
# Slack : signing secret de l'app Slack (signature v0 verifiee)
CHATOPS_SLACK_SIGNING_SECRET=
# Teams / generique : jeton partage envoye dans l'en-tete X-ChatOps-Token
CHATOPS_TOKEN=

# ── Ticketing ITSM (CVE -> ticket) ─────────────────────────────────────────
# Si desactive, les tickets crees restent 'local' (traces en base sans cible).
# PROVIDER : jira | servicenow | glpi | generic (webhook JSON simple).
TICKETING_ENABLED=false
TICKETING_PROVIDER=generic
TICKETING_URL=
TICKETING_USER=
TICKETING_TOKEN=
# Jira : cle du projet ; GLPI : App-Token
TICKETING_PROJECT=
TICKETING_APP_TOKEN=
# Auto-creation d'un ticket pour chaque CVE activement exploitee (CISA KEV)
TICKETING_AUTO_KEV=false

# ── Veille des conteneurs Docker (registres prives) ────────────────────────
# La detection (docker ps/inspect via SSH) et la veille des images publiques
# (Docker Hub, GHCR public) fonctionnent sans configuration. Pour interroger un
# registre PRIVE, fournir un token Bearer par hote (JSON {hote: token}).
# Exemple : {"ghcr.io":"ghp_xxx","registry.interne:5000":"..."}
# DOCKER_REGISTRY_TOKENS={}


# ----------------------------------------------------------------
# Notifications email (rapports CVE, reset mdp, bienvenue)
#
# MAIL_ENABLED=true pour activer l'envoi.
# MAIL_TO accepte plusieurs adresses séparées par des virgules.
#
# Exemples de configuration :
#
#   SMTP classique (OVH, Gmail, etc.) :
#     MAIL_SMTP_HOST=ssl0.ovh.net
#     MAIL_SMTP_PORT=465    MAIL_SMTP_TLS=false  (SMTPS)
#     - ou -
#     MAIL_SMTP_PORT=587    MAIL_SMTP_TLS=true   (STARTTLS)
#     MAIL_SMTP_USER=xxx    MAIL_SMTP_PASSWORD=xxx
#
#   Exchange Online Protection (relay Microsoft 365) :
#     MAIL_SMTP_HOST=mondomaine-fr.mail.protection.outlook.com
#     MAIL_SMTP_PORT=25     MAIL_SMTP_TLS=false
#     MAIL_SMTP_USER=       MAIL_SMTP_PASSWORD=
#     (pas d'auth, IP du serveur Docker whitelistée dans Exchange)
#
# MAIL_DEBUG=true → logs SMTP détaillés dans docker logs php
# ----------------------------------------------------------------
MAIL_ENABLED=false
MAIL_FROM=noreply@mondomaine.com
MAIL_TO=securite@mondomaine.com
MAIL_SMTP_HOST=smtp.mondomaine.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_TLS=true
MAIL_DEBUG=false


# ----------------------------------------------------------------
# Webhooks - notifications Slack / Teams / Discord
#
# Envoie des alertes automatiques sur les événements importants :
#   cve_critical    - CVE critique détectée lors d'un scan
#   cve_high        - CVE haute détectée lors d'un scan
#   deploy_complete - Déploiement SSH terminé
#   server_offline  - Serveur détecté hors ligne
#   update_complete - Mise à jour APT terminée
#
# Types supportés : slack, teams, discord, generic
# ----------------------------------------------------------------
# WEBHOOK_ENABLED=true
# WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# WEBHOOK_TYPE=slack
# WEBHOOK_EVENTS=cve_critical,cve_high,deploy_complete,server_offline
# Secret HMAC pour signer les webhooks de type 'generic' (en-tete
# X-RootWarden-Signature: sha256=...). Le recepteur verifie ainsi
# l'authenticite/integrite du message. Optionnel, ignore pour slack/teams/discord.
# WEBHOOK_SECRET=changez-moi-secret-hmac-aleatoire


# ----------------------------------------------------------------
# Session - durée d'inactivité avant déconnexion automatique
# ----------------------------------------------------------------
# SESSION_TIMEOUT=30  # En minutes (défaut : 30)

# ----------------------------------------------------------------
# Politique de mot de passe - expiration automatique
# ----------------------------------------------------------------
# PASSWORD_EXPIRY_DAYS=90  # Jours avant expiration (défaut : 0 = désactivé)
# PASSWORD_WARN_DAYS=14    # Jours avant expiration pour afficher un avertissement


# ----------------------------------------------------------------
# Rétention des logs - purge automatique des anciens enregistrements
# ----------------------------------------------------------------
# API_THREADPOOL_WORKERS=32   # Threads du pool backend partagé par les routes API (défaut : 32).
#                             # Augmenter si de nombreuses pages SSH tournent en parallèle sur un
#                             # gros parc ; les scans de parc (SSH audit "tout scanner") tournent
#                             # eux en tâche de fond (Centre de tâches) et ne consomment pas ce pool.
# TASK_STALE_HOURS=12         # Watchdog du Centre de tâches : une tâche encore "En cours" après
#                             # ce délai (worker mort : OOM, redémarrage, déploiement) est marquée
#                             # en erreur au lieu de rester zombie pour toujours (défaut : 12,
#                             # 0 = désactivé).
# LOG_RETENTION_DAYS=90       # Jours de conservation (défaut : 0 = désactivé, jamais purgé)
# CVE_SCAN_RETENTION=10       # Plancher : nombre MINIMUM de scans CVE gardés par serveur (défaut : 10)
# CVE_SCAN_RETENTION_DAYS=90  # Fenêtre de rétention des scans CVE en jours (défaut : 90).
#                             # DOIT rester >= 30 : le diagramme "Tendances CVE (30 jours)"
#                             # du dashboard groupe par jour ; une valeur < 30 tronque l'historique.
#                             # Un scan n'est purgé que s'il est à la fois hors des N plus récents
#                             # (CVE_SCAN_RETENTION) ET plus vieux que cette fenêtre.


# ----------------------------------------------------------------
# Backup automatique de la base de données
# ----------------------------------------------------------------
# BACKUP_ENABLED=true             # Active le backup quotidien (défaut : false)
# BACKUP_RETENTION_DAYS=30        # Jours de conservation des dumps (défaut : 30)


# ----------------------------------------------------------------
# Mode Debug - UNIQUEMENT pour le développement local
#
# DEBUG_MODE=true active :
#   • Logging Python niveau DEBUG (requêtes SSH, déchiffrement, stack traces)
#   • Flask en mode debug (rechargement automatique, erreurs détaillées)
#   • PHP : error_reporting(E_ALL) + display_errors=On
#   • Réponses d'erreur détaillées dans l'API REST
#
# LOG_LEVEL : niveau de log Python indépendant du mode debug.
#   Valeurs : DEBUG | INFO | WARNING | ERROR | CRITICAL
#   Par défaut : DEBUG si DEBUG_MODE=true, sinon INFO
#
# ⚠️  NE JAMAIS activer DEBUG_MODE=true en production :
#     expose des informations sensibles (clés, mots de passe, traces).
# ----------------------------------------------------------------
DEBUG_MODE=false
# LOG_LEVEL=INFO

# ----------------------------------------------------------------
# test-server (profile preprod uniquement)
#
# Le container test-server refuse de demarrer si ces deux variables
# ne sont pas definies. Les fallbacks par defaut ont ete supprimes
# en v1.17.0 (audit securite). Genere des mots de passe forts :
#   openssl rand -base64 24
# ----------------------------------------------------------------
# TEST_SERVER_ROOT_PASSWORD=CHANGEZ_MOI_root_preprod
# TEST_SERVER_USER_PASSWORD=CHANGEZ_MOI_testuser_preprod

# ----------------------------------------------------------------
# Feature flags - toggles ON/OFF de modules entiers.
#
# Default : true (les modules sont actifs si la variable est absente).
# Quand un flag est sur "false" :
#   - Backend Python : le blueprint correspondant n'est pas enregistre,
#     toutes les routes /<module>/* retournent 404
#   - PHP : feature_enabled('xxx') retourne false, le menu cache l'entree,
#     /<module>/index.php abort en 404
#
# Apres modification, redemarrer les conteneurs :
#   docker compose up -d
# ----------------------------------------------------------------
WAZUH_ENABLED=true

# ----------------------------------------------------------------
# PORTAIL LARAVEL — authentification (portage v2.0)
#
# Le conteneur `rootwarden_laravel` lit CE fichier (`env_file`). Ces trois
# reglages sont donc a leur place ici et pas dans `laravel/.env`.
#
# BCRYPT_COST         cout du hachage des mots de passe (defaut 12). Doit rester
#                     identique a celui du legacy : les deux portails partagent
#                     la base, un cout plus faible d'un cote serait un
#                     affaiblissement de l'autre.
# HIBP_ENABLED        verification du mot de passe contre Have I Been Pwned, en
#                     k-anonymity (seuls les cinq premiers caracteres de
#                     l'empreinte SHA-1 sortent, jamais le mot de passe).
#                     Desactive par defaut, et FAIL-OPEN assume : bloquer un
#                     changement de mot de passe parce qu'un service tiers est
#                     en panne serait pire que le risque couvert.
# STEP_UP_TENTATIVES  re-authentifications ponctuelles tolerees par minute et
#                     PAR COMPTE (defaut 5, la valeur du legacy). Le legacy en
#                     tolere cinq par SESSION et ne remet pas le compteur a zero
#                     sur succes : cinq step-up legitimes en une minute
#                     echouent.
# ----------------------------------------------------------------
BCRYPT_COST=12
HIBP_ENABLED=false
STEP_UP_TENTATIVES=5
