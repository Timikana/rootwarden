# Dependances
__pycache__/
*.pyc
*.pyo
node_modules/

# Scripts e2e pentest/scratch : contiennent des credentials de test (mots de
# passe localhost + secret TOTP) en dur. Ne JAMAIS committer.
tests/e2e/go-test-pentest.mjs
tests/e2e/*-pentest.mjs
package-lock.json
# ... sauf celui du harnais E2E : sans lui `npm ci` refuse de tourner et
# seul `npm install` passe, ce qui laisse chaque poste resoudre ses propres
# versions. Le LOT de tests n'est reproductible qu'a cette condition.
!tests/e2e/package-lock.json
vendor/
!vendor/composer/
!legacy/vendor/.htaccess

# Secrets — NE JAMAIS commiter ces fichiers
srv-docker.env
srv-docker.env.bak.*
*.env
!srv-docker.env.example
!*.env.example
.first_run_credentials
legacy/.first_run_credentials

# Certificats SSL generes localement
certs/*.pem
certs/*.crt
certs/*.key
ssl/
backend/ssl/

# Logs — generes au runtime
*.log
backend/logs/
legacy/logs/
!legacy/logs/.htaccess

# Backups — generes automatiquement
backend/backups/
backups/
# Exception : legacy/backups/ est du CODE (page UI de gestion des sauvegardes), pas du stockage.
# L'archivage la deplace dans legacy/_deprecated/ : sans cette seconde exception, le dossier
# archive retombe sous la regle `backups/` et tout fichier qu'on y ajouterait deviendrait
# invisible. Les fichiers deja suivis survivent au deplacement, ce qui masque le probleme.
!legacy/backups/
!legacy/backups/**
!legacy/_deprecated/backups/
!legacy/_deprecated/backups/**

# Base de donnees locale
mysql/data/

# Cache Python
backend/__pycache__/
backend/routes/__pycache__/
backend/tests/__pycache__/

# Fichiers IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code : tout est ignore (settings locaux, dumps de skills tiers) SAUF
# les skills projet rw-* (conventions RootWarden partagees avec le repo).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/rw-*/
.mcp.json

# Flag premier demarrage (genere par install.sh)
legacy/.installed

# OS
.DS_Store
Thumbs.db

# Screenshots E2E (generes par Puppeteer)
tests/e2e/screenshots/
# Captures prises a la racine (rendus PDF, planches d'ecrans) : artefacts, jamais suivis.
screenshots/

# Artefacts temporaires
legacy/_ul

# Frontend build
frontend/node_modules/

# Fichiers sensibles generes
*.sql.gz
*.bak
*.dump
fernet.key
.ruff_cache/

# Obsidian vault : partage les notes + config graph/templates,
# ignore les preferences perso (workspace, app, appearance).
obsidian-rootwarden/obsidian-rootwarden-vault/.obsidian/workspace.json
obsidian-rootwarden/obsidian-rootwarden-vault/.obsidian/workspace-mobile.json
obsidian-rootwarden/obsidian-rootwarden-vault/.obsidian/workspaces.json
obsidian-rootwarden/obsidian-rootwarden-vault/.obsidian/app.json
obsidian-rootwarden/obsidian-rootwarden-vault/.obsidian/appearance.json
obsidian-rootwarden/obsidian-rootwarden-vault/.obsidian/hotkeys.json
obsidian-rootwarden/obsidian-rootwarden-vault/.obsidian/cache
# graph.json est regenere en permanence par Obsidian (scale/close/zoom).
# On versionne uniquement graph.json.template ; un script restaure le fichier
# au premier checkout. Les colorGroups par couche restent partages.
obsidian-rootwarden/obsidian-rootwarden-vault/.obsidian/graph.json
# Le junction Windows Code/ -> racine repo ne doit JAMAIS etre committee
# (autoreference infinie quand clone depuis un autre OS).
obsidian-rootwarden/obsidian-rootwarden-vault/Code
obsidian-rootwarden/Code
# Canvas Obsidian "Sans titre" / brouillons
obsidian-rootwarden/**/*.canvas
obsidian-rootwarden/**/Sans*titre*.md


ONBOARDING.md

# Canal de mise a jour memorise par maj.sh (runtime)
.update_channel

# ── POINT DE MONTAGE, PAS UN FICHIER DU PROJET ───────────────────────────────
# `docker-compose.yml` superpose un montage de FICHIER
# (`./legacy/version.txt:/var/www/html/version.txt:ro`) a un montage de
# REPERTOIRE (`./laravel:/var/www/html`). Pour que le premier s'accroche, le
# noyau exige un point de montage : Docker cree donc un fichier VIDE appartenant
# a root du cote hote.
#
#     laravel/version.txt   inode 2011193   0 o   root
#     legacy/version.txt    inode 1998793   7 o   <- la VRAIE source
#
# Il apparaissait dans le `git status` de huit sessions depuis le 2026-09-03, et
# il ressemble a une seconde copie du numero de version — c'est-a-dire a
# exactement ce que le montage existe pour empecher. Il n'en est pas une.
#
# ⛔ NE PAS LE SUPPRIMER : sans point de montage, le montage de fichier ne
# s'accroche plus au prochain demarrage du conteneur.
laravel/version.txt
